{
  "id": "opencode-go-usage",
  "name": "Opencode Go Usage",
  "version": "0.2.1",
  "minNoctaliaVersion": "3.6.0",
  "author": "zumik3-del",
  "license": "MIT",
  "repository": "https://github.com/zumik3-del/noctalia_plugins",
  "description": "Shows Opencode Go AI coding assistant usage limits",
  "tags": [
    "Bar",
    "Productivity",
    "AI"
  ],
  "entryPoints": {
    "main": "Main.qml",
    "barWidget": "BarWidget.qml",
    "panel": "Panel.qml",
    "settings": "Settings.qml"
  },
  "dependencies": {
    "plugins": []
  },
  "metadata": {
    "defaultSettings": {
      "providers": {
        "opencodeGo": {
          "enabled": false,
          "workspaceId": "",
          "cookie": ""
        }
      },
      "barLimit": "5h",
      "refreshIntervalSec": 1800
    }
  }
}
